# 复制成 integrations/cindy/.env，chmod 600。不进仓库。
RECEIVER_PORT=8791
MAITIAN_SUBSCRIBER_ID=cindy-engage
MAITIAN_EVENT_TYPES=comment.created,dm.received
# 补漏间隔（分钟）：用 list_events 把推送漏掉的（例如 OpenBot 先回执了的）补进收件箱
BACKFILL_MINUTES=15
# MAITIAN_OPS_DB=/Users/kinso/code/github/kinsolee/mdldm-maitian/data/ops.db
# CINDY_INBOX_DB=/Users/kinso/code/github/kinsolee/mdldm-maitian/integrations/cindy/data/inbox.db
# CINDY_LEDGER_FILE=/Users/kinso/Documents/OPC-vault/10.个人IP/数据/麦田事件对照-Cindy.jsonl
# 首次登记时由接收端自动写入，不要手填、不要打印：
# MAITIAN_SECRET=
# 麦田 MCP 的 HTTP 版（mcp-http.mjs，给 Cindy 挂）。只监听 127.0.0.1。
CINDY_MCP_PORT=8792
# 首次启动时自动生成写入，不要手填、不要打印；Cindy 里填成 Bearer Token：
# CINDY_MCP_TOKEN=
