<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 模板：复制到 ~/Library/LaunchAgents/ 后 launchctl bootstrap gui/$UID <文件>。路径按实际检出改。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.maitian.cindy-receiver</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/kinso/code/github/kinsolee/mdldm-maitian/integrations/cindy/receiver.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/kinso/code/github/kinsolee/mdldm-maitian</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/kinso/code/github/kinsolee/mdldm-maitian/integrations/cindy/data/receiver.log</string>
  <key>StandardErrorPath</key><string>/Users/kinso/code/github/kinsolee/mdldm-maitian/integrations/cindy/data/receiver.log</string>
</dict>
</plist>
