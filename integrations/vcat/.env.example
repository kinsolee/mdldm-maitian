# 复制成 integrations/vcat/.env，chmod 600。不进仓库。
# 上游小V猫 MCP 地址（仅本机回环）
VCAT_UPSTREAM_URL=http://127.0.0.1:3199/mcp
# 登录钥匙串中的通用密码，账户默认使用当前 macOS 用户名
VCAT_UPSTREAM_TOKEN_KEYCHAIN_SERVICE=vcat-mcp
# VCAT_UPSTREAM_TOKEN_KEYCHAIN_ACCOUNT=

# 只读代理 MCP（给 Cindy 挂），只监听 127.0.0.1
VCAT_PROXY_PORT=8793
# 首次启动时自动生成写入 .env（0600），不要手填、不要打印；Cindy 里填成 Bearer Token
# VCAT_PROXY_TOKEN=

# 本机答题页（独立端口，不碰 8787 工作台）
VCAT_CARDS_PORT=8794
VCAT_CARDS_URL=http://127.0.0.1:8794/cards

# 数据与问答库只读镜像路径
# VCAT_SHADOW_DB=/Users/kinso/code/github/kinsolee/mdldm-maitian/integrations/vcat/data/shadow.db
# VCAT_KB_EXPORT_FILE=/Users/kinso/Documents/OPC-vault/10.个人IP/数据/小V猫问答库.md

# 采集回看天数（仅读小V猫本机已采数据，refresh 永远为 false）
VCAT_LOOKBACK_DAYS=3
# 自有账号昵称或 ID（逗号分隔，辅助跳过 Kinso 自己的评论与私信）
# VCAT_SELF_AUTHORS=
