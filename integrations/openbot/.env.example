# 复制成 integrations/openbot/.env，chmod 600。不进仓库。
# OpenBot 自带 CLI；OpenBot 升级后路径变了就改这里。启动时找不到会直接报错退出。
OPENBOT_CLI=/Applications/OpenBot.app/Contents/Resources/cli/openbot-cli.mjs
OPENBOT_AGENT=数据小管家
RECEIVER_PORT=8790
MAITIAN_SUBSCRIBER_ID=openbot-engage
MAITIAN_EVENT_TYPES=comment.created,dm.received
# MAITIAN_OPS_DB=/Users/kinso/code/github/kinsolee/mdldm-maitian/data/ops.db
# 首次登记时由接收端自动写入，不要手填、不要打印：
# MAITIAN_SECRET=
